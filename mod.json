{
  "geode": "5.6.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "arctium.assist-menu",
  "name": "Assist Menu",
  "version": "v1.0.0",
  "developer": "Arctium",
  "description": "Assist Menu (AM) is a practice and accessibility toolkit: a timing guide bar, practice helpers, a clean HUD, run stats and graphs, volume and accessibility options. Help, not cheats.",
  "settings": {
    "enabled": {
      "type": "bool",
      "default": true,
      "name": "Enabled"
    },
    "side": {
      "type": "string",
      "default": "Right",
      "one-of": [
        "Right",
        "Left"
      ],
      "name": "Bar Side"
    },
    "margin": {
      "type": "int",
      "default": 10,
      "min": 0,
      "max": 80,
      "name": "Edge Margin (px)"
    },
    "bar-height": {
      "type": "float",
      "default": 70,
      "min": 30,
      "max": 95,
      "name": "Bar Height (%)",
      "control": {
        "slider": true
      }
    },
    "bar-width": {
      "type": "int",
      "default": 54,
      "min": 32,
      "max": 120,
      "name": "Bar Width (px)"
    },
    "opacity": {
      "type": "float",
      "default": 100,
      "min": 20,
      "max": 100,
      "name": "Opacity (%)",
      "control": {
        "slider": true
      }
    },
    "accent": {
      "type": "string",
      "default": "Cyan",
      "one-of": [
        "Cyan",
        "Magenta",
        "Lime",
        "Amber",
        "Violet",
        "Silver"
      ],
      "name": "Accent Color"
    },
    "view-distance": {
      "type": "float",
      "default": 14,
      "min": 6,
      "max": 40,
      "name": "View Distance (blocks)",
      "description": "How far ahead the bar looks. Lower = segments move faster."
    },
    "press-offset": {
      "type": "int",
      "default": 90,
      "min": 0,
      "max": 300,
      "name": "Press Offset (ms)",
      "description": "How early the segment reaches the line before the obstacle."
    },
    "glow": {
      "type": "bool",
      "default": true,
      "name": "Glow Effects"
    },
    "scroll-grid": {
      "type": "bool",
      "default": true,
      "name": "Scrolling Grid",
      "description": "Faint lines that scroll with your speed."
    },
    "danger-ids": {
      "type": "string",
      "default": "8,39,103,392,9,61",
      "name": "Spike Object IDs",
      "description": "Comma separated object IDs counted as obstacles. Copy again after changing."
    },
    "upright-only": {
      "type": "bool",
      "default": true,
      "name": "Upright Spikes Only",
      "description": "Ignore ceiling and sideways spikes."
    },
    "hold-channel": {
      "type": "int",
      "default": 1000,
      "min": 0,
      "max": 9999,
      "name": "Hold Marker Color Channel",
      "description": "Blocks using this color channel become hold segments. 0 disables. Copy again after changing."
    },
    "merge-gap": {
      "type": "float",
      "default": 2,
      "min": 0.5,
      "max": 8,
      "name": "Merge Gap (blocks)",
      "description": "Spikes closer than this become one segment."
    },
    "show-menu": {
      "type": "bool",
      "default": true,
      "name": "Show Menu Button",
      "description": "Round logo on the pause menu and the level page. Tap it to open the Jump Guide menu."
    },
    "hud-percent": {
      "type": "bool",
      "default": false,
      "name": "Info: Percent"
    },
    "hud-fps": {
      "type": "bool",
      "default": false,
      "name": "Info: FPS"
    },
    "hud-clock": {
      "type": "bool",
      "default": false,
      "name": "Info: Clock"
    },
    "hud-session": {
      "type": "bool",
      "default": false,
      "name": "Info: Attempts (session)"
    },
    "hud-best": {
      "type": "bool",
      "default": false,
      "name": "Info: Best % (session)"
    },
    "hud-timer": {
      "type": "bool",
      "default": false,
      "name": "Overlay: Timer"
    },
    "hud-clicks": {
      "type": "bool",
      "default": false,
      "name": "Overlay: Click counter"
    },
    "hud-cps": {
      "type": "bool",
      "default": false,
      "name": "Overlay: CPS meter"
    },
    "hud-progress": {
      "type": "bool",
      "default": false,
      "name": "Overlay: Progress bar"
    },
    "hud-bestmark": {
      "type": "bool",
      "default": false,
      "name": "Overlay: Best run marker"
    },
    "hud-pos": {
      "type": "string",
      "default": "Top left",
      "one-of": [
        "Top left",
        "Top right",
        "Bottom left",
        "Bottom right"
      ],
      "name": "Overlay Position"
    },
    "hud-size": {
      "type": "float",
      "default": 1.0,
      "min": 0.6,
      "max": 1.6,
      "name": "Overlay Size"
    },
    "death-markers": {
      "type": "bool",
      "default": false,
      "name": "Death Markers",
      "description": "Shows a small red cross where an attempt ended."
    },
    "auto-checkpoints": {
      "type": "bool",
      "default": false,
      "name": "Auto Checkpoints",
      "description": "Places checkpoints on a timer. Practice mode only."
    },
    "checkpoint-timer": {
      "type": "float",
      "default": 2.0,
      "min": 1,
      "max": 10,
      "name": "Checkpoint Timer (s)"
    },
    "music-volume": {
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 100,
      "name": "Music Volume (%)"
    },
    "sfx-volume": {
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 100,
      "name": "SFX Volume (%)"
    },
    "click-sound": {
      "type": "bool",
      "default": false,
      "name": "Click Sounds",
      "description": "Plays a soft tick every time you press."
    },
    "colorblind": {
      "type": "string",
      "default": "Off",
      "one-of": [
        "Off",
        "Deutan",
        "Protan",
        "Tritan"
      ],
      "name": "Colorblind Mode",
      "description": "Changes the hit and miss colors of the timing bar."
    },
    "high-contrast": {
      "type": "bool",
      "default": false,
      "name": "High Contrast"
    },
    "large-text": {
      "type": "bool",
      "default": false,
      "name": "Large Text"
    },
    "ui-scale": {
      "type": "int",
      "default": 100,
      "min": 70,
      "max": 130,
      "name": "UI Scale (%)"
    },
    "reduce-effects": {
      "type": "bool",
      "default": false,
      "name": "Reduce Effects",
      "description": "Turns off pulses and ripples in the Assist Menu and the timing bar."
    }
  }
}